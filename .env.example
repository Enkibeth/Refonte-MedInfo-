# Copier en .env (gitignored). Ne JAMAIS commiter les vraies valeurs.
# LLM — provider actif : anthropic (défaut) ou openai
AI_PROVIDER=anthropic
AI_MODEL_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Classifieur étage 2 (deuxième lecture, 07_CLASSIFIER §3) — Gemini 2.5 Flash-Lite.
# Sans GOOGLE_GENERATIVE_AI_API_KEY, l'étage 2 reste désactivé (fail-safe ambiguous).
GOOGLE_GENERATIVE_AI_API_KEY=
# Surcharge optionnelle du modèle d'étage 2 (défaut Gemini 2.5 Flash-Lite).
CLASSIFIER_MODEL_ID=
# Embedding / rerank
VOYAGE_API_KEY=
COHERE_API_KEY=
# Supabase — projet dédié MedInfo
# EXPO_PUBLIC_* est injecté dans le bundle client (auth + RLS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL publique autorisée dans Supabase Auth (Site URL/Redirect URLs).
# Recommandé en prod pour éviter que les emails de confirmation pointent vers localhost/Expo dev.
EXPO_PUBLIC_AUTH_REDIRECT_URL=
# Variables serveur (routes API). SUPABASE_URL doit pointer vers le même projet.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Vérif pro (ANS Annuaire Santé FHIR). Clé obtenue sur portail.openfhir.annuaire.sante.fr
# (catalogue → abonnement « Annuaire Santé FHIR »). Sans clé : statut pro `pending`.
ANNUAIRE_SANTE_API_KEY=
# Optionnels — overrides selon ton abonnement ANS (sinon défauts gateway v2 / en-tête ESANTE-API-KEY).
# Recherche RPPS par valeur seule par défaut (robuste v1/v2) ; ANNUAIRE_SANTE_RPPS_SYSTEM force un system FHIR.
ANNUAIRE_SANTE_API_URL=
ANNUAIRE_SANTE_API_KEY_HEADER=
ANNUAIRE_SANTE_RPPS_SYSTEM=
# Stripe (facturation web-first, ADR-0012) — secrets hors repo, à poser dans hPanel.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# price_id Stripe par plan (06_BILLING §1). Aucun plan pro (gelé ADR-0006).
STRIPE_PRICE_PUBLIC_MID=
STRIPE_PRICE_STUDENT_MID=
STRIPE_PRICE_STUDENT_PREMIUM=
# URL publique du site : success_url/cancel_url Stripe, canonicals SEO, sitemap, domaine
# canonique (redirection www → apex). À poser AU BUILD *et* à l'exécution — hPanel injecte
# ses variables aux deux moments. Production : https://medinfo-ai.com ; pendant la recette
# sur le domaine temporaire Hostinger : https://<domaine-temporaire>.hostingersite.com.
EXPO_PUBLIC_APP_URL=
# Cron hebdo du blog (agent éditorial, ADR-0025). Le cron système appelle
# /api/cron/weekly-blog avec `Authorization: Bearer ${CRON_SECRET}`
# (scripts/hostinger/weekly-blog-cron.sh). SANS cette variable, la route refuse
# le déclenchement (401, fail-closed). Générer : openssl rand -hex 32
CRON_SECRET=
# Email / monitoring
RESEND_API_KEY=
SENTRY_DSN=

# ── Serveur Node (Hostinger) — docs/09_DEPLOYMENT.md ───────────────────────────────────
# Chez Hostinger (hPanel « Node.js Web Apps »), NE PAS définir PORT : l'hébergeur l'attribue
# au démarrage. HOST vide = écoute sur toutes les interfaces (IPv4 + IPv6). Sur un VPS
# derrière nginx : PORT=3000 et HOST=127.0.0.1.
PORT=
HOST=
# Lecture des en-têtes X-Forwarded-* du reverse proxy (TLS terminé en amont). Laisser vide
# (= activé) derrière LiteSpeed/nginx/CDN ; `false` UNIQUEMENT si Node est exposé en direct.
TRUST_PROXY=
# Nombre de proxys de confiance devant Node (défaut 1). Sert à lire l'IP réelle du client
# pour le quota anonyme ; à passer à 2 seulement si le journal « [medinfo] proxy : … »
# indique deux derniers maillons « différents » (CDN Hostinger devant le serveur web).
TRUST_PROXY_HOPS=
# Domaine canonique (sans schéma). Vide = dérivé de EXPO_PUBLIC_APP_URL. Seule la variante
# www ↔ apex de ce domaine est redirigée (308) — jamais un autre hôte.
CANONICAL_HOST=
# Journal d'accès (chemins seulement, jamais d'IP ni de query string) : `off` pour le taire.
ACCESS_LOG=
# Emplacement de `dist` si le build est déployé ailleurs que dans le dossier de l'app.
EXPO_DIST_DIR=
